
pipeline {
    agent any

    tools {
        maven 'Maven-3.10.1'
    }

    stages {

        // Stage 1: GitHub source code is checked out by Jenkins SCM
        stage('Git Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        // Stage 2: Build and test the Maven application
        stage('Maven Build') {
            steps {
                dir('docker-using-jenkins/tomcat-web-application') {
                    sh 'mvn clean verify'
                }
            }
        }

        // Stage 3: Analyze code using SonarQube
        stage('SonarQube Analysis') {
            steps {
                dir('docker-using-jenkins/tomcat-web-application') {
                    withSonarQubeEnv('SonarQube-Server') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }

        failure {
            echo 'Pipeline execution failed!'
        }

        always {
            echo 'Pipeline execution completed!'
        }
    }
}
